namespace TerminalApp
{
    [default_interface] runtimeclass PaneTabViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        PaneTabViewModel();

        // Stable identity (the model's TabId.v); not observed.
        UInt64 Id { get; set; };

        // Observable display state. Title drives the native TabViewItem header /
        // tooltip; IsActive drives TabView.SelectedItem (a one-way model→control
        // selection projection — TabStripView pushes SelectedItem when IsActive
        // flips). A user SelectionChanged is an intent only and never writes
        // IsActive back from the control.
        //
        // Workspaces M2 (#54, ADR-001): Title is now a COMPUTED effective title —
        // CustomTitle (the model's TabRecord.customTitle, set by rename) wins when
        // non-empty, else the live shell title. The Title SETTER writes the LIVE
        // title (the live-push path keeps calling vm.Title(content.Title())); the
        // rename diff arm writes CustomTitle. A later live TitleChanged therefore
        // cannot clobber a user's custom title.
        String Title { get; set; };
        Boolean IsActive { get; set; };

        // Intent signals. The VM NEVER touches the WorkspaceModel; it raises
        // these so the owning TerminalPage can dispatch the model action
        // (selectTab / closeTab) and let the resulting diff re-project the strip.
        // TabStripView raises RequestActivate from TabView.SelectionChanged (user
        // intent) and RequestClose from TabView.TabCloseRequested.
        void RequestActivate();
        void RequestClose();

        // sender = the VM (carries Id so the page resolves the tab); args =
        // null (the intent carries no payload beyond Id).
        event Windows.Foundation.TypedEventHandler<PaneTabViewModel, IInspectable> ActivateRequested;
        event Windows.Foundation.TypedEventHandler<PaneTabViewModel, IInspectable> CloseRequested;

        // The live content background COLOR, projected as a fresh non-acrylic
        // SolidColorBrush (TerminalPage extracts the color from the mounted
        // IPaneContent's BackgroundBrush()). A pure downstream projection of the
        // mounted content — the VM never reads it back from the model. (M1 keeps
        // this projection running but the native MUX TabView themes its selected
        // tab itself; wiring the selected-tab background to track this content
        // color the classic way — Tab::_RecalculateAndApplyTabColor — is a
        // DEFERRED SHOULD per ADR-001.) APPENDED LAST: inserting a property
        // mid-runtimeclass shifts vtable slots and trips the /RTCs "Stack around
        // 'value' corrupted" trap.
        Windows.UI.Xaml.Media.Brush Background { get; set; };

        // Workspaces M1 (#54, ADR-001): the tab icon PATH, projected from the
        // mounted IPaneContent's Icon(). TabStripView resolves it to a MUX
        // IconSource via IconPathConverter::IconSourceMUX and sets it on the
        // native TabViewItem.IconSource (mirroring classic Tab::UpdateIcon). A
        // pure downstream projection of the mounted content. APPENDED LAST (after
        // Background) for the same vtable-slot reason.
        String Icon { get; set; };

        // Workspaces M2 (#54, ADR-001): the model's TabRecord.customTitle — the
        // user-chosen title set via rename. A pure downstream projection of the
        // model (the TabDecorationUpdated diff arm sets it through the page;
        // the VM never writes it back). When non-empty it WINS over the live
        // shell title in the computed Title; empty means "no custom title, use
        // the live title". APPENDED LAST (after Icon) for the same vtable-slot
        // reason (inserting mid-runtimeclass trips the /RTCs corruption trap).
        String CustomTitle { get; set; };

        // Workspaces M2 (#54, ADR-001): rename INTENT. TabStripView wires the
        // hosted TabHeaderControl's TitleChangeRequested to raise this with the
        // committed title; the owning TerminalPage dispatches setTabTitle for this
        // VM's Id, and the resulting TabDecorationUpdated diff arm projects the
        // new customTitle back onto CustomTitle. The VM NEVER touches the model.
        void RequestRename(String newTitle);

        // sender = the VM (carries Id); args = the committed title (a boxed
        // String). APPENDED LAST for the vtable-slot reason.
        event Windows.Foundation.TypedEventHandler<PaneTabViewModel, IInspectable> RenameRequested;

        // Workspaces M3 (#54, ADR-001): the tab BELL/attention indicator. This is
        // VM-RUNTIME state, NOT a WorkspaceModel field — an ADR deviation. A bell
        // is ephemeral content-emitted attention (auto-dismissed on focus / a
        // timer) with no user-authored override, exactly the category M2 already
        // pushes onto the VM directly (the live shell title) rather than into the
        // replayable model. The WorkspaceView's BellRequested subscription sets it
        // true (off-thread, marshaled to the UI thread); the active-tab projection
        // (_setActivePaneTabVm) and a per-tab DispatcherTimer clear it. TabStripView
        // drives the hosted TabHeaderControl's TerminalTabStatus.BellIndicator from
        // it via the PropertyChanged path. APPENDED LAST (after RenameRequested) for
        // the same vtable-slot reason (inserting mid-runtimeclass trips the /RTCs
        // "Stack around 'value' corrupted" trap).
        Boolean BellIndicator { get; set; };
    }
}
