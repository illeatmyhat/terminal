namespace TerminalApp
{
    [default_interface] runtimeclass TabRowControl : Windows.UI.Xaml.Controls.ContentPresenter,
                                                     Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        TabRowControl();
        Microsoft.UI.Xaml.Controls.TabView TabView { get; };
        Boolean ShowElevationShield;

        // Workspace chrome accessors (visible only after EnableWorkspacesMode()).
        Windows.UI.Xaml.Controls.Button HamburgerButton { get; };
        Microsoft.UI.Xaml.Controls.SplitButton NewWorkspaceButton { get; };
        Windows.UI.Xaml.Controls.TextBlock WorkspaceTitleText { get; };
        void EnableWorkspacesMode();
    }
}
