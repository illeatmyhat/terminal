<Page x:Class="TerminalApp.TerminalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:TerminalApp"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mtu="using:Microsoft.Terminal.UI"
      xmlns:mux="using:Microsoft.UI.Xaml.Controls"
      Background="Transparent"
      mc:Ignorable="d">

    <!--
        Workspaces (experimental.workspaces.enabled) shell restructure (#46).

        The page root is now a vertical stack of two regions:
          Row 0 — a full-width titlebar chrome row. When the workspaces flag
                  is ON, the inline WorkspaceChrome (hamburger + new-workspace
                  split-button; min/max/close come from the host TitlebarControl
                  once the chrome is handed to it via SetTitleBarContent) is
                  realized here and then lifted into the window titlebar. When
                  the flag is OFF the chrome is never realized and this Auto row
                  collapses to zero height.
          Row 1 — the body, a two-column [sidebar | content] grid. The sidebar
                  column is Width=Auto and its StackPanel is Collapsed unless the
                  flag is ON, so flag-off collapses it to zero width and the
                  content column fills the entire body — byte-for-byte upstream.
                  The content column holds the original three rows (TabRow,
                  InfoBar stack, TabContent) unchanged, plus the dialogs/toasts.

        Keeping the titlebar as its own full-width top row (rather than letting
        the sidebar run full-height) preserves the custom non-client caption
        drag area / min-max-close hit-testing — the sidebar lives in the CLIENT
        area below the titlebar.
    -->
    <Grid x:Name="Root"
          Background="Transparent">
        <Grid.RowDefinitions>
            <!--  Row 0 — full-width titlebar chrome row (collapses to 0 when WorkspaceChrome is unrealized).  -->
            <RowDefinition Height="Auto" />
            <!--  Rows 1-3 — the original TabRow / InfoBar stack / TabContent rows, unchanged.  -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Column 0 is the workspaces sidebar (Auto width; zero when its
            content is unrealized/Collapsed). Column 1 is the classic content.
            Flag-off, the sidebar is never realized, so column 0 is zero-width
            and column 1 fills the whole grid — byte-for-byte upstream.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Inline WorkspaceChrome shell, spanning the full width of the top
            row. Realized via FindName only on the flag-on path (see
            TerminalPage::_initializeWorkspaceShell), then re-parented into the
            host titlebar through SetTitleBarContent so the window's
            min/max/close caption buttons sit beside it. The hamburger and
            new-workspace split-button are present-but-inert this slice.
        -->
        <Grid x:Name="WorkspaceChrome"
              Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              x:Load="False"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="WorkspaceHamburgerButton"
                    Grid.Column="0"
                    Width="40"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="&#xE700;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    IsEnabled="False" />

            <mux:SplitButton x:Name="NewWorkspaceButton"
                             Grid.Column="1"
                             Height="32"
                             Margin="4,0,0,0"
                             VerticalAlignment="Center"
                             Content="&#xE710;"
                             FontFamily="{ThemeResource SymbolThemeFontFamily}"
                             FontSize="12"
                             IsEnabled="False" />
        </Grid>

        <!--
            Read-only workspace sidebar. Lives in the CLIENT area BELOW the
            titlebar (rows 1-3, column 0), so it never interferes with the
            custom non-client caption drag area / min-max-close hit-testing.
            Collapsed (zero-width Auto column) unless the flag is on; on the
            flag-on path TerminalPage realizes it via FindName, flips Visibility
            to Visible, and maintains one row per workspace in declared order
            from the WorkspaceView projection. Read-only this slice: rows are
            non-interactive TextBlocks.
        -->
        <StackPanel x:Name="WorkspaceSidebar"
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    x:Load="False"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Orientation="Vertical"
                    Visibility="Collapsed" />

        <local:TabRowControl x:Name="TabRow"
                             Grid.Row="1"
                             Grid.Column="1"
                             KeyUp="_KeyDownHandler" />

        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <mux:InfoBar x:Name="KeyboardServiceWarningInfoBar"
                         x:Load="False"
                         CornerRadius="0"
                         IsClosable="True"
                         IsIconVisible="True"
                         IsOpen="False"
                         Message="{x:Bind KeyboardServiceDisabledText, Mode=OneWay}"
                         Severity="Warning">
                <mux:InfoBar.ActionButton>
                    <Button x:Uid="InfoBarDismissButton"
                            Click="_KeyboardServiceWarningInfoDismissHandler" />
                </mux:InfoBar.ActionButton>
            </mux:InfoBar>

            <mux:InfoBar x:Name="CloseOnExitInfoBar"
                         x:Uid="CloseOnExitInfoBar"
                         x:Load="False"
                         CornerRadius="0"
                         IsClosable="True"
                         IsIconVisible="True"
                         IsOpen="False"
                         Severity="Informational">
                <mux:InfoBar.ActionButton>
                    <Button x:Uid="InfoBarDismissButton"
                            Click="_CloseOnExitInfoDismissHandler" />
                </mux:InfoBar.ActionButton>
            </mux:InfoBar>
        </StackPanel>

        <Grid x:Name="TabContent"
              Grid.Row="3"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.Background>
                <ImageBrush />
            </Grid.Background>
        </Grid>

        <!--
            GH#12775 et. al: After switching to ControlsV2, it seems that
            delay-loading a dialog causes the ContentDialog to be assigned a
            Height equal to its content size. If we DON'T assign the
            ContentDialog a Row, I believe it's assigned Row 0 by default. So,
            when the dialog gets opened, the dialog seemingly causes a giant
            hole to appear in the body of the app.
            
            Assigning all the dialogs to Row 2 (where the rest of the content
            is) makes the "hole" appear in the same space as the rest of the
            TabContent, fixing the issue.
            
            Note that the actual content in a content dialog gets parented to
            the PopupRoot, so it actually always appeared in the correct place, it's
            just this weird hole that appeared in Row 0.
        -->

        <local:AboutDialog x:Name="AboutDialog"
                           Grid.Row="3"
                           Grid.Column="1"
                           x:Load="False" />

        <ContentDialog x:Name="ConfirmCloseDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary">
            <CheckBox x:Uid="DontAskAgainCheckBox" />
        </ContentDialog>

        <ContentDialog x:Name="CloseReadOnlyDialog"
                       x:Uid="CloseReadOnlyDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Close" />

        <ContentDialog x:Name="MultiLinePasteDialog"
                       x:Uid="MultiLinePasteDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary">
            <StackPanel>
                <TextBlock x:Uid="MultiLineWarningText"
                           TextWrapping="Wrap" />
                <TextBlock x:Uid="ClipboardTextHeader"
                           Margin="0,16,0,0" />
                <ScrollViewer x:Name="ClipboardContentScrollViewer"
                              MaxHeight="100"
                              Margin="0,8,0,0">
                    <TextBlock x:Name="ClipboardText"
                               FontFamily="Cascadia Mono"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="LargePasteDialog"
                       x:Uid="LargePasteDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary" />

        <ContentDialog x:Name="ControlNoticeDialog"
                       x:Uid="ControlNoticeDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary">
            <TextBlock IsTextSelectionEnabled="True"
                       TextWrapping="WrapWholeWords">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
                <Run x:Name="NoticeMessage" />
            </TextBlock>
        </ContentDialog>

        <ContentDialog x:Name="UriErrorDialog"
                       x:Uid="UriErrorDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Close">
            <TextBlock IsTextSelectionEnabled="True"
                       TextWrapping="WrapWholeWords">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
                <Run x:Name="CouldNotOpenUriReason" /> <LineBreak /> <LineBreak />
                <Run x:Name="UnopenedUri"
                     FontFamily="Cascadia Mono" />
            </TextBlock>
        </ContentDialog>

        <local:CommandPalette x:Name="CommandPaletteElement"
                              Grid.Row="3"
                              Grid.Column="1"
                              VerticalAlignment="Stretch"
                              x:Load="False"
                              PreviewKeyDown="_KeyDownHandler"
                              Visibility="Collapsed" />

        <local:SuggestionsControl x:Name="SuggestionsElement"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  x:Load="False"
                                  PreviewKeyDown="_KeyDownHandler"
                                  Visibility="Collapsed" />

        <!--
            A TeachingTip with IsLightDismissEnabled="True" will immediately
            dismiss itself if the window is unfocused (In Xaml Islands). This is
            tracked by MUX#4382
        -->
        <mux:TeachingTip x:Name="WindowIdToast"
                         Grid.Column="1"
                         Title="{x:Bind WindowProperties.WindowIdForDisplay}"
                         x:Load="False"
                         IsLightDismissEnabled="True"
                         Subtitle="{x:Bind WindowProperties.WindowNameForDisplay, Mode=OneWay}" />

        <mux:TeachingTip x:Name="WindowRenamer"
                         x:Uid="WindowRenamer"
                         Grid.Column="1"
                         Title="{x:Bind WindowProperties.WindowIdForDisplay}"
                         x:Load="False"
                         ActionButtonClick="_WindowRenamerActionClick"
                         ActionButtonStyle="{ThemeResource AccentButtonStyle}"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <TextBox x:Name="WindowRenamerTextBox"
                         KeyDown="_WindowRenamerKeyDown"
                         KeyUp="_WindowRenamerKeyUp"
                         Text="{x:Bind WindowProperties.WindowName, Mode=OneWay}">
                    <TextBox.ContextFlyout>
                        <mtu:TextMenuFlyout />
                    </TextBox.ContextFlyout>
                </TextBox>
            </mux:TeachingTip.Content>
        </mux:TeachingTip>

        <mux:TeachingTip x:Name="WindowCwdToast"
                         x:Uid="WindowCwdToast"
                         Grid.Column="1"
                         Title="{x:Bind WindowProperties.VirtualWorkingDirectory, Mode=OneWay}"
                         x:Load="False"
                         IsLightDismissEnabled="True" />

        <mux:TeachingTip x:Name="ActionSavedToast"
                         x:Uid="ActionSavedToast"
                         Grid.Column="1"
                         Title="Action Saved"
                         HorizontalAlignment="Stretch"
                         x:Load="False"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical">
                    <TextBlock x:Name="ActionSavedNameText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionName), Mode=OneWay}">
                        <Run Text="Name: " />
                        <Run Text="{x:Bind SavedActionName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ActionSavedKeyChordText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionKeyChord), Mode=OneWay}">
                        <Run Text="Key Chord: " />
                        <Run Text="{x:Bind SavedActionKeyChord, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ActionSavedCommandLineText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionCommandLine), Mode=OneWay}">
                        <Run Text="Input: " />
                        <Run Text="{x:Bind SavedActionCommandLine, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </mux:TeachingTip.Content>
        </mux:TeachingTip>
        <mux:TeachingTip x:Name="ActionSaveFailedToast"
                         x:Uid="ActionSaveFailedToast"
                         Grid.Column="1"
                         Title="Action Save Failed"
                         x:Load="False"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <TextBlock x:Name="ActionSaveFailedMessage"
                           Text="" />
            </mux:TeachingTip.Content>
        </mux:TeachingTip>
    </Grid>
</Page>
