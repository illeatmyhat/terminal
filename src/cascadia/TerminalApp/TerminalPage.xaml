<Page x:Class="TerminalApp.TerminalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:TerminalApp"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mtu="using:Microsoft.Terminal.UI"
      xmlns:mux="using:Microsoft.UI.Xaml.Controls"
      Background="Transparent"
      mc:Ignorable="d">

    <!--
        Workspaces (experimental.workspaces.enabled) shell restructure (#46).

        The page root is now a vertical stack of two regions:
          Row 0 — a full-width titlebar chrome row. When the workspaces flag
                  is ON, the inline WorkspaceChrome (hamburger + new-workspace
                  split-button; min/max/close come from the host TitlebarControl
                  once the chrome is handed to it via SetTitleBarContent) is
                  realized here and then lifted into the window titlebar. When
                  the flag is OFF the chrome is never realized and this Auto row
                  collapses to zero height.
          Row 1 — the body, a two-column [sidebar | content] grid. The sidebar
                  column is Width=Auto and its StackPanel is Collapsed unless the
                  flag is ON, so flag-off collapses it to zero width and the
                  content column fills the entire body — byte-for-byte upstream.
                  The content column holds the original three rows (TabRow,
                  InfoBar stack, TabContent) unchanged, plus the dialogs/toasts.

        Keeping the titlebar as its own full-width top row (rather than letting
        the sidebar run full-height) preserves the custom non-client caption
        drag area / min-max-close hit-testing — the sidebar lives in the CLIENT
        area below the titlebar.
    -->
    <Grid x:Name="Root"
          Background="Transparent">
        <Grid.RowDefinitions>
            <!--  Row 0 — full-width titlebar chrome row (collapses to 0 when WorkspaceChrome is unrealized).  -->
            <RowDefinition Height="Auto" />
            <!--  Rows 1-3 — the original TabRow / InfoBar stack / TabContent rows, unchanged.  -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Column 0 is the workspaces sidebar (Auto width; zero when its
            content is unrealized/Collapsed). Column 1 is the classic content.
            Flag-off, the sidebar is never realized, so column 0 is zero-width
            and column 1 fills the whole grid — byte-for-byte upstream.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Inline WorkspaceChrome shell, spanning the full width of the top
            row. Realized via FindName only on the flag-on path (see
            TerminalPage::_initializeWorkspaceShell), then re-parented into the
            host titlebar through SetTitleBarContent so the window's
            min/max/close caption buttons sit beside it. The hamburger and
            new-workspace split-button are present-but-inert this slice.
        -->
        <Grid x:Name="WorkspaceChrome"
              Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              x:Load="False"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="WorkspaceHamburgerButton"
                    Grid.Column="0"
                    Width="32"
                    Height="24"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="&#xE700;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    IsEnabled="False" />

            <!--
                New-workspace split button. Styled to match the tab strip's
                NewTabButton (+ | v chevron): the primary button creates a
                workspace with the default profile, the chevron flyout offers
                one entry per profile. Click + flyout are wired in code in
                TerminalPage::_initializeWorkspaceShell.
            -->
            <!--
                Brush overrides + button sizes are hoisted to App.xaml's
                app-level resources (shared with the tab strip's NewTabButton).
            -->
            <mux:SplitButton x:Name="NewWorkspaceButton"
                             Grid.Column="1"
                             Height="24"
                             Margin="4,0,0,0"
                             Padding="0"
                             VerticalAlignment="Center"
                             BorderThickness="0"
                             Content="&#xE710;"
                             FontFamily="{ThemeResource SymbolThemeFontFamily}"
                             FontSize="12" />
        </Grid>

        <!--
            Read-only workspace sidebar (#52, Stage 2). Lives in the CLIENT area
            BELOW the titlebar (rows 1-3, column 0), so it never interferes with
            the custom non-client caption drag area / min-max-close hit-testing.
            Collapsed (zero-width Auto column) unless the flag is on; on the
            flag-on path TerminalPage realizes it via FindName, flips Visibility
            to Visible, and binds its ItemsSource to the observable
            WorkspaceViewModel collection. The UI is a pure projection of the
            model: each DataTemplate row re-renders from its OneWay bindings as
            the change-stream arms mutate the view-models. Read-only this stage:
            rows carry no input handlers (rename/color/pin triggers land in
            Stage 3).
        -->
        <ItemsControl x:Name="WorkspaceSidebar"
                      Grid.Row="1"
                      Grid.RowSpan="3"
                      Grid.Column="0"
                      MinWidth="220"
                      x:Load="False"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                      Visibility="Collapsed">
            <!--
                A bare ItemsControl's generated template is just an
                ItemsPresenter with no Border, so it never paints its own
                Background and the sidebar reads through to the acrylic/desktop.
                Supply an explicit template that fills the control with its
                Background brush behind the rows.
            -->
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:WorkspaceViewModel">
                    <Grid Padding="12,8,12,8"
                          Background="{x:Bind local:WorkspaceViewModel.ActiveToRowBrush(IsActive), Mode=OneWay}"
                          ColumnSpacing="8"
                          DoubleTapped="{x:Bind BeginRename}"
                          Loaded="{x:Bind OnRowLoaded}"
                          Tapped="{x:Bind RequestActivate}">
                        <!--
                            Right-click context menu (#52, Stage 3a). x:Bind Click
                            handlers in a DataTemplate bind to the row's VM, which
                            raises intent events; the page dispatches the model
                            action. Literal "Rename"/"Pin"/"Unpin" this slice (no
                            workspace-specific RS_ resources yet); the Pin label is
                            dynamic via the PinLabel(IsPinned) static helper.
                        -->
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="{x:Bind BeginRename}"
                                                Text="Rename" />
                                <MenuFlyoutItem Click="{x:Bind TogglePin}"
                                                Text="{x:Bind local:WorkspaceViewModel.PinLabel(IsPinned), Mode=OneWay}" />
                                <MenuFlyoutItem Click="{x:Bind ShowColorPicker}"
                                                Text="Change color&#x2026;">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Glyph="&#xE790;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Color swatch: shown only when the workspace has a color. -->
                        <Border Grid.Column="0"
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Background="{x:Bind mtu:Converters.ColorToBrush(Color), Mode=OneWay}"
                                CornerRadius="2"
                                Visibility="{x:Bind local:WorkspaceViewModel.BoolToVisibility(HasColor), Mode=OneWay}" />
                        <!--
                            Title TextBlock (shown when NOT editing) vs inline
                            rename TextBox (shown when IsEditing). The editor is
                            two-way bound to EditText, focuses + selects-all on
                            load, commits on Enter / LostFocus, cancels on Escape.
                        -->
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontWeight="{x:Bind local:WorkspaceViewModel.ActiveToFontWeight(IsActive), Mode=OneWay}"
                                   Text="{x:Bind Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind local:WorkspaceViewModel.InvertedBoolToVisibility(IsEditing), Mode=OneWay}" />
                        <TextBox Grid.Column="1"
                                 MinHeight="0"
                                 Padding="4,2,4,2"
                                 VerticalAlignment="Center"
                                 IsSpellCheckEnabled="False"
                                 KeyDown="{x:Bind OnEditorKeyDown}"
                                 Loaded="{x:Bind OnEditorLoaded}"
                                 LostFocus="{x:Bind CommitRename}"
                                 MaxLength="1024"
                                 Text="{x:Bind EditText, Mode=TwoWay}"
                                 Visibility="{x:Bind local:WorkspaceViewModel.BoolToVisibility(IsEditing), Mode=OneWay}" />
                        <!-- Pin glyph: shown only when the workspace is pinned. -->
                        <FontIcon Grid.Column="2"
                                  VerticalAlignment="Center"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  Glyph="&#xE718;"
                                  Visibility="{x:Bind local:WorkspaceViewModel.BoolToVisibility(IsPinned), Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <local:TabRowControl x:Name="TabRow"
                             Grid.Row="1"
                             Grid.Column="1"
                             KeyUp="_KeyDownHandler" />

        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <mux:InfoBar x:Name="KeyboardServiceWarningInfoBar"
                         x:Load="False"
                         CornerRadius="0"
                         IsClosable="True"
                         IsIconVisible="True"
                         IsOpen="False"
                         Message="{x:Bind KeyboardServiceDisabledText, Mode=OneWay}"
                         Severity="Warning">
                <mux:InfoBar.ActionButton>
                    <Button x:Uid="InfoBarDismissButton"
                            Click="_KeyboardServiceWarningInfoDismissHandler" />
                </mux:InfoBar.ActionButton>
            </mux:InfoBar>

            <mux:InfoBar x:Name="CloseOnExitInfoBar"
                         x:Uid="CloseOnExitInfoBar"
                         x:Load="False"
                         CornerRadius="0"
                         IsClosable="True"
                         IsIconVisible="True"
                         IsOpen="False"
                         Severity="Informational">
                <mux:InfoBar.ActionButton>
                    <Button x:Uid="InfoBarDismissButton"
                            Click="_CloseOnExitInfoDismissHandler" />
                </mux:InfoBar.ActionButton>
            </mux:InfoBar>
        </StackPanel>

        <Grid x:Name="TabContent"
              Grid.Row="3"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.Background>
                <ImageBrush />
            </Grid.Background>

            <!--
                Big-flip Slice B (#54): the flag-on content host. The
                ContentRegistry's factory-built IPaneContent for the ACTIVE
                workspace is parented in here (its GetRoot()), so the
                attach/swap-on-switch plumbing can be proved structurally
                BEHIND the still-visible classic tab content. Kept
                Collapsed this slice — Slice F flips its visibility and
                retires the classic _tabContent swap. x:Load="False" so the
                flag-off path never realizes it (byte-for-byte upstream);
                _initializeWorkspaceShell realizes it via FindName when the
                flag is on. It shares TabContent's single cell, but Collapsed
                means it neither renders nor hit-tests, so it cannot occlude
                the classic content.
            -->
            <Grid x:Name="WorkspaceContentHost"
                  x:Load="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Big-flip Slice C (#54): the per-leaf tab strip — the
                    invisible projection of a leaf pane's tabs. A ListView (NOT
                    a MUX TabView: AllowDropTabs + CanReorderTabs crash on
                    drag-out, GH#mux-tabview-drag) bound to the ACTIVE leaf's
                    PaneTabViewModel collection; SelectedItem follows IsActive,
                    a per-row close affordance raises CloseRequested, and the
                    row's Tapped raises ActivateRequested. The VM never touches
                    the model; the page dispatches the action and the diff
                    re-projects the strip.

                    INVISIBLE this slice: the strip is Collapsed AND lives
                    inside the Collapsed host, so it neither renders nor
                    hit-tests — the classic tab stays the only thing on screen.
                    The strip's ItemsSource is bound by the page (active leaf),
                    and the visible new-tab "+"/keybinding triggers are wired in
                    Slice F when the strip becomes visible; this slice only
                    builds the strip + its arm projection.
                -->
                <ListView x:Name="PaneTabStrip"
                          Grid.Row="0"
                          x:Load="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          SelectionMode="Single"
                          Visibility="Collapsed">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PaneTabViewModel">
                            <Grid ColumnSpacing="6"
                                  Padding="8,4,4,4"
                                  Tapped="{x:Bind RequestActivate}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="{x:Bind local:PaneTabViewModel.ActiveToFontWeight(IsActive), Mode=OneWay}"
                                           Text="{x:Bind Title, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="{x:Bind RequestClose}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="10"
                                              Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    Big-flip Slice D (#54): the projected SPLIT pane tree of the
                    ACTIVE workspace. The page rebuilds this container's single
                    child from the active workspace's model pane tree on the
                    split arms (SplitPaneCreated / SplitPaneCollapsed /
                    SplitRatioChanged): each SplitPane node becomes a nested Grid
                    with two star-sized cells (sized from the model ratio) along
                    the split axis; each LeafPane node becomes a leaf container
                    holding that leaf's own Slice-C strip (reused by PaneId) over
                    the leaf's content host. It mirrors the model tree
                    structurally so the XAML can never diverge from `root`.

                    INVISIBLE this slice: it lives inside the Collapsed host, so
                    it neither renders nor hit-tests — the classic Pane tree
                    stays the visible split. Each split Grid now carries a CUSTOM
                    draggable separator Border between its two cells (Slice F-1,
                    #54 — NOT a toolkit GridSplitter); it is invisible until
                    Slice F-5 flips the host visible and retires the classic
                    split.
                -->
                <Grid x:Name="WorkspacePaneTreeRoot"
                      Grid.Row="1"
                      x:Load="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
            </Grid>
        </Grid>

        <!--
            GH#12775 et. al: After switching to ControlsV2, it seems that
            delay-loading a dialog causes the ContentDialog to be assigned a
            Height equal to its content size. If we DON'T assign the
            ContentDialog a Row, I believe it's assigned Row 0 by default. So,
            when the dialog gets opened, the dialog seemingly causes a giant
            hole to appear in the body of the app.
            
            Assigning all the dialogs to Row 2 (where the rest of the content
            is) makes the "hole" appear in the same space as the rest of the
            TabContent, fixing the issue.
            
            Note that the actual content in a content dialog gets parented to
            the PopupRoot, so it actually always appeared in the correct place, it's
            just this weird hole that appeared in Row 0.
        -->

        <local:AboutDialog x:Name="AboutDialog"
                           Grid.Row="3"
                           Grid.Column="1"
                           x:Load="False" />

        <ContentDialog x:Name="ConfirmCloseDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary">
            <CheckBox x:Uid="DontAskAgainCheckBox" />
        </ContentDialog>

        <ContentDialog x:Name="CloseReadOnlyDialog"
                       x:Uid="CloseReadOnlyDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Close" />

        <ContentDialog x:Name="MultiLinePasteDialog"
                       x:Uid="MultiLinePasteDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary">
            <StackPanel>
                <TextBlock x:Uid="MultiLineWarningText"
                           TextWrapping="Wrap" />
                <TextBlock x:Uid="ClipboardTextHeader"
                           Margin="0,16,0,0" />
                <ScrollViewer x:Name="ClipboardContentScrollViewer"
                              MaxHeight="100"
                              Margin="0,8,0,0">
                    <TextBlock x:Name="ClipboardText"
                               FontFamily="Cascadia Mono"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="LargePasteDialog"
                       x:Uid="LargePasteDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary" />

        <ContentDialog x:Name="ControlNoticeDialog"
                       x:Uid="ControlNoticeDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Primary">
            <TextBlock IsTextSelectionEnabled="True"
                       TextWrapping="WrapWholeWords">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
                <Run x:Name="NoticeMessage" />
            </TextBlock>
        </ContentDialog>

        <ContentDialog x:Name="UriErrorDialog"
                       x:Uid="UriErrorDialog"
                       Grid.Row="3"
                       Grid.Column="1"
                       x:Load="False"
                       DefaultButton="Close">
            <TextBlock IsTextSelectionEnabled="True"
                       TextWrapping="WrapWholeWords">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
                <Run x:Name="CouldNotOpenUriReason" /> <LineBreak /> <LineBreak />
                <Run x:Name="UnopenedUri"
                     FontFamily="Cascadia Mono" />
            </TextBlock>
        </ContentDialog>

        <local:CommandPalette x:Name="CommandPaletteElement"
                              Grid.Row="3"
                              Grid.Column="1"
                              VerticalAlignment="Stretch"
                              x:Load="False"
                              PreviewKeyDown="_KeyDownHandler"
                              Visibility="Collapsed" />

        <local:SuggestionsControl x:Name="SuggestionsElement"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  x:Load="False"
                                  PreviewKeyDown="_KeyDownHandler"
                                  Visibility="Collapsed" />

        <!--
            A TeachingTip with IsLightDismissEnabled="True" will immediately
            dismiss itself if the window is unfocused (In Xaml Islands). This is
            tracked by MUX#4382
        -->
        <mux:TeachingTip x:Name="WindowIdToast"
                         Grid.Column="1"
                         Title="{x:Bind WindowProperties.WindowIdForDisplay}"
                         x:Load="False"
                         IsLightDismissEnabled="True"
                         Subtitle="{x:Bind WindowProperties.WindowNameForDisplay, Mode=OneWay}" />

        <mux:TeachingTip x:Name="WindowRenamer"
                         x:Uid="WindowRenamer"
                         Grid.Column="1"
                         Title="{x:Bind WindowProperties.WindowIdForDisplay}"
                         x:Load="False"
                         ActionButtonClick="_WindowRenamerActionClick"
                         ActionButtonStyle="{ThemeResource AccentButtonStyle}"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <TextBox x:Name="WindowRenamerTextBox"
                         KeyDown="_WindowRenamerKeyDown"
                         KeyUp="_WindowRenamerKeyUp"
                         Text="{x:Bind WindowProperties.WindowName, Mode=OneWay}">
                    <TextBox.ContextFlyout>
                        <mtu:TextMenuFlyout />
                    </TextBox.ContextFlyout>
                </TextBox>
            </mux:TeachingTip.Content>
        </mux:TeachingTip>

        <mux:TeachingTip x:Name="WindowCwdToast"
                         x:Uid="WindowCwdToast"
                         Grid.Column="1"
                         Title="{x:Bind WindowProperties.VirtualWorkingDirectory, Mode=OneWay}"
                         x:Load="False"
                         IsLightDismissEnabled="True" />

        <mux:TeachingTip x:Name="ActionSavedToast"
                         x:Uid="ActionSavedToast"
                         Grid.Column="1"
                         Title="Action Saved"
                         HorizontalAlignment="Stretch"
                         x:Load="False"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical">
                    <TextBlock x:Name="ActionSavedNameText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionName), Mode=OneWay}">
                        <Run Text="Name: " />
                        <Run Text="{x:Bind SavedActionName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ActionSavedKeyChordText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionKeyChord), Mode=OneWay}">
                        <Run Text="Key Chord: " />
                        <Run Text="{x:Bind SavedActionKeyChord, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ActionSavedCommandLineText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionCommandLine), Mode=OneWay}">
                        <Run Text="Input: " />
                        <Run Text="{x:Bind SavedActionCommandLine, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </mux:TeachingTip.Content>
        </mux:TeachingTip>
        <mux:TeachingTip x:Name="ActionSaveFailedToast"
                         x:Uid="ActionSaveFailedToast"
                         Grid.Column="1"
                         Title="Action Save Failed"
                         x:Load="False"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <TextBlock x:Name="ActionSaveFailedMessage"
                           Text="" />
            </mux:TeachingTip.Content>
        </mux:TeachingTip>
    </Grid>
</Page>
