    directory as part of the project layout.
  -->
  <ItemGroup>
    <None Include="regressions\sample-newworkspace-then-closeworkspace.json" />
  </ItemGroup>

  <!-- ====================== Compiler & Linker Flags ===================== -->
  <ItemDefinitionGroup>
